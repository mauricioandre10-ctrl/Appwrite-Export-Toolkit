# Archivos y carpetas que Git ignora: dependencias, builds, secrets,
# backups generados y otros artefactos que no deben ir al repositorio.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated backups / exports
/backups
/exports
/data
/.data
/.jobs

# env files
.env*
!.env.example

# sensitive files
*.pem
*.key
*.cert
credentials*
service-account*

# build artifacts
*.tsbuildinfo
next-env.d.ts
.turbo

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# docker
docker-compose.override.yml

# vercel
.vercel

# misc
*.log

# documentation (keep README.md)
*.md
!README.md
