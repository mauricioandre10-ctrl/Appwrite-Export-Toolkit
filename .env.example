# Appwrite source project
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID=""
APPWRITE_API_KEY=""

# Optional target project for restore/import operations
APPWRITE_TARGET_ENDPOINT=""
APPWRITE_TARGET_PROJECT_ID=""
APPWRITE_TARGET_API_KEY=""

# Backup output defaults
# Use /data/backups in Docker with a persistent volume mounted at /data.
BACKUP_OUTPUT_DIR="/data/backups"
BACKUP_FORMAT_VERSION="1.0.0"

# Web login
APP_LOGIN_USER="admin"
APP_LOGIN_PASSWORD="change-me-now"
