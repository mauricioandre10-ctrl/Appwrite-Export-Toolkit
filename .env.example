# Archivo de ejemplo con las variables de entorno necesarias para el toolkit.
# Copia este archivo como .env y completa los valores antes de ejecutar.
NIXPACKS_NODE_VERSION=22
# Appwrite source project
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID=""
APPWRITE_API_KEY=""

# Optional target project for restore/import operations
APPWRITE_TARGET_ENDPOINT=""
APPWRITE_TARGET_PROJECT_ID=""
APPWRITE_TARGET_API_KEY=""

# Backup output directory
# Production (Docploy/Docker): use a persistent volume at /data/backups.
# Development (local without root): leave default and the app will fallback
# automatically to <project-root>/.data/backups and then to os.tmpdir().
BACKUP_OUTPUT_DIR="/data/backups"
BACKUP_FORMAT_VERSION="1.0.0"

# Web login
APP_LOGIN_USER="admin"
APP_LOGIN_PASSWORD="change-me-now"

# Protección CSRF (requerido, generar con: openssl rand -hex 32)
APP_CSRF_SECRET=""

# Runtime
LOG_LEVEL="info"
# SCHEDULER_DISABLED="1"
# COOKIE_SECURE="1"
